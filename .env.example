# Copy this file to an environment your host injects. Do not commit real values.
# The process exits with an error if a required variable is missing or invalid.
# There are no default tokens, hashes, user ids, or database URIs in the code.

# --- Required ---

# From https://my.telegram.org (integer, no quotes needed)
API_ID=

# From https://my.telegram.org
API_HASH=

# From @BotFather. Looks like 123456789:AA...
BOT_TOKEN=

# MongoDB connection string. mongodb:// or mongodb+srv://
# DB_URL and MONGO_URL are accepted aliases.
DATABASE_URL=

# Your Telegram user id. The owner is always an admin and is the only account that can restart.
OWNER_ID=

# Private database channel id, usually -100 followed by the channel id.
# The bot must be an admin there and allowed to post.
CHANNEL_ID=

# --- Database and process ---

# Mongo database name inside the cluster. Not a secret. Default: kdrama
DATABASE_NAME=kdrama

# HTTP port for the health check. Koyeb sets PORT. Default: 8000
PORT=8000

# Bind address for the health server. Default: 0.0.0.0
WEB_HOST=0.0.0.0

# Pyrogram worker count. TG_BOT_WORKERS is an accepted alias. Default: 8
WORKERS=8

# --- Channels and admins ---

# Optional chat that receives startup and new-user logs. Defaults to OWNER_ID.
LOG_CHANNEL=

# Extra admin user ids, comma or space separated. OWNER_ID is always included.
ADMINS=

# Force-subscribe channels, comma separated.
# Optional button label after a pipe: -100123|Updates,-100456|Backups
# FORCE_SUB_CHANNEL is an accepted alias. Leave empty to disable.
FORCE_SUB_CHANNELS=

# Channels from the list above (or additional ones) that use join requests.
# A pending request counts as subscribed. Example: -100456
FORCE_SUB_REQUEST_CHANNELS=

# Approve join requests automatically (true/false). Default: false
AUTO_APPROVE_JOIN=false

# --- Files and messages ---

# Seconds before a delivered file is deleted from the private chat. 0 disables. Default: 600
FILE_AUTO_DELETE=600

# Send files with content protection (true/false). Default: false
# Restricted batch links always protect, and this flag also protects normal sends.
PROTECT_CONTENT=false

# Skip the Share button on database-channel posts (true/false). Default: false
DISABLE_CHANNEL_BUTTON=false

# Welcome text. HTML. Placeholders: {first} {last} {id} {mention} {username} {uptime}
START_MESSAGE=

# Photo URL or Telegram file id shown with the welcome text. Empty sends text only.
START_PIC=

# Shown when someone still has to join. Same placeholders as START_MESSAGE.
FORCE_SUB_MESSAGE=

# Caption template for delivered media. Empty keeps the original caption.
# Placeholders: {filename} {previouscaption} {filesize} {filetype}
CUSTOM_CAPTION=

# Message sent after auto-delete, above the Get again button.
AUTO_DELETE_MESSAGE=

# Optional reply to ordinary private text from non-admins. Empty disables it.
# Placeholders: {first} {last} {id} {mention} {username} {uptime}
USER_REPLY_TEXT=

# Largest range accepted by /batch and /cbatch. Default: 50. Maximum: 200
MAX_BATCH=50

# --- Link verification (optional) ---

# Shortener endpoint. Either a URL that accepts ?api=&url= or a template
# containing {api} and {url}. Leave empty to disable verification.
SHORTENER_URL=

# Shortener API key. Never commit a real key.
SHORTENER_API=

# Force the gate on or off. When unset, it turns on only if both values above are set.
SHORTENER_ENABLED=

# Button shown next to the verification link, for example a tutorial post.
VERIFY_TUTORIAL=

# How long one successful verification lasts, in hours (1-168). Default: 12
TOKEN_HOURS=12

# --- Premium bypasses (true/false) ---

PREMIUM_BYPASS_FORCESUB=true
PREMIUM_BYPASS_SHORTENER=true
PREMIUM_BYPASS_AUTODELETE=true

# --- Limits and housekeeping ---

# File opens allowed per user in RATE_WINDOW seconds. Admins are exempt. Default: 8
RATE_LIMIT=8

# Window for RATE_LIMIT, in seconds. Default: 30
RATE_WINDOW=30

# Optional URL the process GETs every 4 minutes. Leave empty on Koyeb.
KEEP_ALIVE_URL=

# Log each first /start to LOG_CHANNEL (true/false). Default: true
NEW_USER_LOG=true
